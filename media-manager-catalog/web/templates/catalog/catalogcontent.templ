package catalog

import (
    "media-manager/internal/catalogmodel"
)

templ CatalogContent(page catalogmodel.CatalogPage) {
    <div id="catalog-content">
        @Breadcrumb(page.Breadcrumb, page.Directories)
        <div class="p-4">
            @ImageGrid(page.Images)
        </div>
    </div>
}
