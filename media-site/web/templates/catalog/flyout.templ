package catalog

import (
	"fmt"
	"strconv"
	"strings"

	"media-site/internal/catalogmodel"
)

// Flyout renders the left-edge panel's content: aggregated inv.db info for
// data.Dir and everything beneath it, plus a filter form pre-filled with
// whatever criteria are already applied (data.Filter). Submitting Apply
// re-queries the catalog page's grid, scoped to the same subtree; Clear
// reloads the page with no filter.
templ Flyout(data catalogmodel.FlyoutData) {
	<div class="flyout-panel-content">
		<p class="menu-label">In this directory and below</p>
		<p class="mb-3">{ fmt.Sprintf("%d files", data.TotalFiles) }</p>
		<form
			hx-get="/catalog"
			hx-target="#catalog-content"
			hx-select="#catalog-content"
			hx-swap="outerHTML"
			hx-push-url="true"
		>
			<input type="hidden" name="dir" value={ data.Dir }/>

			<div class="field">
				<label class="label is-small">Tag</label>
				<input
					class="input is-small"
					type="text"
					name="tag"
					list="flyout-tags"
					placeholder="comma-separated"
					value={ strings.Join(data.Filter.Tags, ", ") }
				/>
				<datalist id="flyout-tags">
					for _, t := range data.Tags {
						<option value={ t.Name }>{ fmt.Sprintf("%s (%d)", t.Name, t.Count) }</option>
					}
				</datalist>
			</div>

			<div class="field">
				<label class="label is-small">Site</label>
				<input class="input is-small" type="text" name="site" list="flyout-sites" value={ data.Filter.Site }/>
				<datalist id="flyout-sites">
					for _, s := range data.Sites {
						<option value={ s.Site }>{ fmt.Sprintf("%s (%d)", s.Site, s.Count) }</option>
					}
				</datalist>
			</div>

			<div class="field">
				<label class="label is-small">Status</label>
				<input class="input is-small" type="text" name="status" list="flyout-statuses" value={ data.Filter.Status }/>
				<datalist id="flyout-statuses">
					for _, s := range data.Statuses {
						<option value={ s.Status }>{ fmt.Sprintf("%s (%d)", s.Status, s.Count) }</option>
					}
				</datalist>
			</div>

			<div class="field">
				<label class="label is-small">
					{ fmt.Sprintf("Width (%d–%d)", data.Dimensions.WidthMin, data.Dimensions.WidthMax) }
				</label>
				<div class="field has-addons">
					<div class="control">
						<input class="input is-small" type="number" name="widthMin" placeholder="min" value={ intOrEmpty(data.Filter.WidthMin) }/>
					</div>
					<div class="control">
						<input class="input is-small" type="number" name="widthMax" placeholder="max" value={ intOrEmpty(data.Filter.WidthMax) }/>
					</div>
				</div>
			</div>

			<div class="field">
				<label class="label is-small">
					{ fmt.Sprintf("Height (%d–%d)", data.Dimensions.HeightMin, data.Dimensions.HeightMax) }
				</label>
				<div class="field has-addons">
					<div class="control">
						<input class="input is-small" type="number" name="heightMin" placeholder="min" value={ intOrEmpty(data.Filter.HeightMin) }/>
					</div>
					<div class="control">
						<input class="input is-small" type="number" name="heightMax" placeholder="max" value={ intOrEmpty(data.Filter.HeightMax) }/>
					</div>
				</div>
			</div>

			<div class="field">
				<label class="label is-small">
					{ fmt.Sprintf("Discovered (%s – %s)", orDash(data.Discovered.From), orDash(data.Discovered.To)) }
				</label>
				<div class="field has-addons">
					<div class="control">
						<input class="input is-small" type="date" name="discoveredFrom" value={ data.Filter.DiscoveredFrom }/>
					</div>
					<div class="control">
						<input class="input is-small" type="date" name="discoveredTo" value={ data.Filter.DiscoveredTo }/>
					</div>
				</div>
			</div>

			<div class="field is-grouped mt-4">
				<div class="control">
					<button type="submit" class="button is-small is-link">Apply</button>
				</div>
				<div class="control">
					<a
						class="button is-small"
						hx-get={ "/catalog?dir=" + data.Dir }
						hx-target="#catalog-content"
						hx-select="#catalog-content"
						hx-swap="outerHTML"
						hx-push-url="true"
					>
						Clear
					</a>
				</div>
			</div>
		</form>
	</div>
}

// intOrEmpty renders n as a string, or "" for the zero value — zero means
// "no bound set", which should show as a blank input, not a literal 0.
func intOrEmpty(n int) string {
	if n == 0 {
		return ""
	}
	return strconv.Itoa(n)
}

// orDash renders s, or "—" if s is empty — used only in the Discovered
// label's range hint, never in a form value.
func orDash(s string) string {
	if s == "" {
		return "—"
	}
	return s
}
