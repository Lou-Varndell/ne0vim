package catalog

import (
    "media-site/internal/catalogmodel"
)

templ CatalogContent(page catalogmodel.CatalogPage) {
    <div id="catalog-content" data-dir={ page.CurrentDir }>
        @Breadcrumb(page.Breadcrumb, page.Directories)
        <div class="p-4">
            @ImageGrid(page.CurrentDir, page.Filter, page.ImageBatch)
        </div>
    </div>
}
